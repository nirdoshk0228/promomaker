# Optional: turn on the AI editor (LLM re-ranking of the shortlist).
# On Render, set these on the service's Environment page. Never commit real keys.
PROMOFINDER_LLM_PROVIDER=gemini          # gemini | groq | openai | openrouter | anthropic | custom
PROMOFINDER_LLM_API_KEY=
# PROMOFINDER_LLM_MODEL=                 # the provider's current model name (defaults are best guesses)
# PROMOFINDER_LLM_BASE_URL=              # only for provider=custom (any OpenAI-compatible endpoint)
# PROMOFINDER_LLM_WEIGHT=0.5             # how much the AI editor's score counts (0-1)
# PROMOFINDER_LLM_MAX_CLIPS=60           # clips judged per run (keep low on free tiers)
# PROMOFINDER_LLM_BATCH=6                # clips per request
# PROMOFINDER_LLM_WORKERS=1              # parallel requests
# PROMOFINDER_LLM_MAX_WAIT=30            # longest rate-limit wait (s) before giving up
# PROMOFINDER_ADMIN_TOKEN=               # needed for POST /api/model/retrain
# PROMOFINDER_DB=./promofinder.db
# PROMOFINDER_MAX_UPLOAD_MB=25
# PROMOFINDER_MAX_VIDEO_MB=500
