# Optional: turn on the AI editor (LLM re-ranking of the shortlist).
# Groq and Gemini both have free tiers; any OpenAI-compatible endpoint works with provider=custom.
PROMOFINDER_LLM_PROVIDER=groq
PROMOFINDER_LLM_API_KEY=
# PROMOFINDER_LLM_MODEL=llama-3.3-70b-versatile
# PROMOFINDER_LLM_BASE_URL=        # only for provider=custom
# PROMOFINDER_LLM_WEIGHT=0.5       # how much the AI editor's score counts (0-1)
# PROMOFINDER_DB=./promofinder.db
# PROMOFINDER_MAX_UPLOAD_MB=25
